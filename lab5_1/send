#!/usr/bin/env python3
import sys
from gpiozero import LED
from time import sleep

led = LED(17)

char_per_sec = 1
max_dur = 1/char_per_sec
dash = max_dur/10
dot = dash/4
off = dot

conversions = [ "a.-/",
				"b-.../",
				"c-.-./",
				"d-../",
				"e./",
				"f..-./",
				"g--./",
				"h..../",
				"i../",
				"j.---/",
				"k-.-/",
				"l.-../",
				"m--/",
				"n-./",
				"o---/",
				"p.--./",
				"q--.-/",
				"r.-./",
				"s.../",
				"t-/",
				"u..-/",
				"v...-/",
				"w.--/",
				"x-..-/",
				"y-.--/",
				"z--../",
				"1.----/",
				"2..---/",
				"3...--/",
				"4....-/",
				"5...../",
				"6-..../",
				"7--.../",
				"8---../",
				"9----./",
				"0-----/",
				" -...-/"
				]

def get_code(c):
	for code in conversions:
		if code[0].lower() == c.lower():
			return code[1:]

def main():
	if len(sys.argv) != 3:
		print("incorrect number of arguments")
		return

	n = int(sys.argv[1])
	msg = sys.argv[2]

	for _ in range(n):
		for c in msg:
			code = get_code(c)
			for d in code:
				led.on()
				if d == ".":
					sleep(dot)
				elif d == "-":
					sleep(dash)
				led.off()
				sleep(off)
			sleep(dash)

if __name__ == "__main__":
	main()